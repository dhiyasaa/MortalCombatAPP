<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/settingbgblur">

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text=" "
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"
        android:layout_alignParentTop="true"
        android:fontFamily="@font/cinzel_font"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/lg">

        <ImageView
            android:id="@+id/back_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Back Icon"
            android:src="@drawable/panah_left"
            app:tint="@color/white"/>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Back Icon"
            android:src="@drawable/mortal_combat_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/cinzel"
            android:text="SETTINGS"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_theme"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/settings_title"
        android:layout_marginTop="37dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/white"
        android:elevation="4dp"
        android:fontFamily="@font/cinzel_font"
        android:text="Theme"

        android:textColor="#000000"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_update"
        android:layout_width="200dp"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content"
        android:text="Update"
        android:layout_marginBottom="10dp"
        android:layout_below="@id/btn_theme"
        android:backgroundTint="@color/white"
        android:elevation="4dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:fontFamily="@font/cinzel_font"/>

    <Button
        android:id="@+id/btn_rating"
        android:layout_width="200dp"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content"
        android:text="Rating"
        android:layout_marginBottom="10dp"
        android:layout_below="@id/btn_update"
        android:backgroundTint="@color/white"
        android:elevation="4dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:fontFamily="@font/cinzel_font"/>

    <Button
        android:id="@+id/btn_info_privacy"
        android:layout_width="200dp"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content"
        android:text="Informasi dan Privasi"
        android:layout_below="@id/btn_rating"
        android:elevation="4dp"
        android:textStyle="bold"
        android:backgroundTint="@color/white"
        android:textColor="#000000"
        android:fontFamily="@font/cinzel_font"/>
</RelativeLayout>
